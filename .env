# ============================================================================
# WC Premium Audit Platform — Environment Variables
# Phase 2 — Local Development Configuration
#
# FOR FULL KEYCLOAK FLOW (docker-compose up):
#   SKIP_JWT_VERIFICATION=false  +  VITE_SKIP_AUTH=false  (defaults below)
#
# FOR LOCAL DEV (no Docker Keycloak):
#   Change both to true
# ============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=auditplatform
POSTGRES_PASSWORD=auditplatform_dev
POSTGRES_DB=auditplatform

# These are used by the backend container directly
DATABASE_URL=postgresql+asyncpg://auditplatform:auditplatform_dev@db:5432/auditplatform
SYNC_DATABASE_URL=postgresql+psycopg2://auditplatform:auditplatform_dev@db:5432/auditplatform

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── AWS S3 (logo uploads) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET_NAME=wc-audit-platform-assets
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT_URL=

# ── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=audit-platform
KEYCLOAK_CLIENT_ID=audit-platform-backend
KEYCLOAK_CLIENT_SECRET=audit-platform-backend-secret
KEYCLOAK_FRONTEND_CLIENT_ID=audit-platform-frontend

# ── JWT / Auth ───────────────────────────────────────────────────────────────
SKIP_JWT_VERIFICATION=false

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
PLATFORM_DOMAIN=localhost

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=audit-platform
VITE_KEYCLOAK_CLIENT_ID=audit-platform-frontend
VITE_PLATFORM_DOMAIN=localhost
VITE_SKIP_AUTH=false

VITE_BACKEND_URL=http://localhost:8000
# SKIP_JWT_VERIFICATION=true