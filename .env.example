# ============================================================================
# WC Premium Audit Platform — Environment Variables
# Phase 2 — copy to .env and fill values
# ============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/audit_platform
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/audit_platform

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── AWS S3 (logo uploads) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET_NAME=wc-audit-platform-assets
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT_URL=                         # Leave blank for real AWS; set for LocalStack

# ── Keycloak (Phase 2) ───────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=audit-platform
KEYCLOAK_CLIENT_ID=audit-platform-backend
KEYCLOAK_CLIENT_SECRET=change-me-in-production
KEYCLOAK_FRONTEND_CLIENT_ID=audit-platform-frontend

# ── JWT / Auth ───────────────────────────────────────────────────────────────
# Set to "true" during local development to skip RS256 verification
SKIP_JWT_VERIFICATION=false

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-a-long-random-string
LOG_LEVEL=INFO

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=audit-platform
VITE_KEYCLOAK_CLIENT_ID=audit-platform-frontend
VITE_PLATFORM_DOMAIN=platform.local          # Used for subdomain routing + cross-origin guard
VITE_SKIP_AUTH=false                          # Set to "true" for dev bypass (Phase 1 mock user)
