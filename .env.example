# =============================================================================
# WC Premium Audit Platform — Environment Variables Example
# Copy this file to .env and fill in values for local development.
# =============================================================================

# Database
DATABASE_URL=postgresql+asyncpg://auditplatform:auditplatform_dev@localhost:5432/auditplatform

# Redis
REDIS_URL=redis://localhost:6379/0

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=audit-platform
KEYCLOAK_CLIENT_ID=audit-platform-backend
KEYCLOAK_CLIENT_SECRET=audit-platform-backend-secret
KEYCLOAK_FRONTEND_CLIENT_ID=audit-platform-frontend

# JWT verification (set to true for local dev without Keycloak)
SKIP_JWT_VERIFICATION=false

# Anthropic AI (for narrative generation)
ANTHROPIC_API_KEY=

# S3 / MinIO (Phase 5)
# For local development, MinIO runs at localhost:9000
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET=audit-platform-uploads

# Application
ENVIRONMENT=development
LOG_LEVEL=DEBUG
PLATFORM_DOMAIN=localhost
