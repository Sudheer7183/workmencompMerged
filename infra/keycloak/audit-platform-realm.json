      "firstName": "Demo",
      "lastName": "Reviewer",
      "credentials": [
        {
          "type": "password",
          "value": "reviewer123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "reviewer"
      ],
      "attributes": {
        "tenant_slug": [
          "demo"
        ],
        "role": [
          "REVIEWER"
        ]
      }
    },
    {
      "username": "service-account-audit-platform-backend",
      "enabled": true,
      "email": "service-account-audit-platform-backend@placeholder.org",
      "serviceAccountClientId": "audit-platform-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "manage-realm",
          "create-client",
          "query-users",
          "query-groups"
        ]
      }
    }
  ]
}